# Copiar a .env . NUNCA subir .env a Git (RNF-01).
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://baches:baches@db:5432/baches

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-esto-antes-de-cualquier-despliegue
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://storage:8333
S3_ACCESS_KEY=bachesdev
S3_SECRET_KEY=bachesdev-secret
S3_BUCKET_EVIDENCIA=evidencia

DEDUPE_RADIO_M=15
DEDUPE_VENTANA_DIAS=30
GPS_PRECISION_MAX_M=50
